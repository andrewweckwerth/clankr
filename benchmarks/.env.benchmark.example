# Copy this file to benchmarks/.env.benchmark on the VM. This is deliberately
# separate from production's .env; it initializes a project-scoped benchmark DB.
BENCHMARK_ENVIRONMENT=isolated
POSTGRES_USER=clankr_benchmark
POSTGRES_PASSWORD=replace-with-a-benchmark-only-password
POSTGRES_DB=clankr_benchmark
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=clankr-benchmark
MINIO_SECRET_KEY=replace-with-a-benchmark-only-secret
MINIO_BUCKET=clankr-benchmark-audio
MINIO_SECURE=false
REDIS_URL=redis://redis:6379/0
INTERNAL_AUTH_SECRET=replace-with-a-long-benchmark-only-secret
FRONTEND_ORIGIN=http://unused-benchmark-host
APP_HOST=unused-benchmark-host
LETSENCRYPT_EMAIL=unused@example.invalid
# `latest` is convenient for a local smoke test. Pin both images to the same
# Git commit SHA when you need a reproducible comparison.
IMAGE_PREFIX=ghcr.io/andrewweckwerth/clankr
IMAGE_TAG=latest
